{
	"name": "@sonisoft/now-sdk-ext-core",
	"version": "3.8.2",
	"description": "Comprehensive TypeScript library extending ServiceNow SDK with application management, ATF testing, real-time log monitoring, AMB event subscriptions, and automation tools",
	"keywords": [
		"servicenow",
		"sdk",
		"automation",
		"testing",
		"atf",
		"cicd",
		"devops",
		"logs",
		"monitoring",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/ddonnelly19/nowsdk-ext-core.git"
	},
	"type": "module",
	"author": "",
	"license": "MIT",
	"scripts": {
		"build": "npm run clean && npm run build-index-export && npm run buildts",
		"buildts": "tsc && tsc-alias",
		"build-index-export": "ctix build",
		"clean": "rimraf dist",
		"lint": "tsc --noEmit && eslint src",
		"test": "npm run test:unit",
		"test:unit": "vitest run --reporter=verbose test/unit",
		"test:integration": "vitest run --reporter=verbose test/integration",
		"test:all": "vitest run --reporter=verbose",
		"watch-test": "vitest --reporter=verbose test/unit"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@servicenow/sdk-cli": "^4.6.0",
		"@servicenow/sdk-cli-core": "^3.0.2",
		"@xmldom/xmldom": "^0.9.10",
		"axios": "^1.16.0",
		"cometd": "^9.0.0",
		"dotenv": "^17.4.2",
		"fast-xml-parser": "^5.7.2",
		"http-proxy-agent": "^9.0.0",
		"https-proxy-agent": "^9.0.0",
		"tough-cookie": "^6.0.1",
		"ts-toolbelt": "^9.6.0",
		"winston": "^3.19.0",
		"ws": "^8.20.0",
		"xml2js": "^0.6.2"
	},
	"devDependencies": {
		"@types/jsdom": "^28.0.1",
		"@types/ws": "^8.18.1",
		"@types/xml2js": "^0.4.14",
		"@vitest/coverage-v8": "^4.1.5",
		"cross-env": "^10.1.0",
		"crypto-js": "^4.2.0",
		"jsdom": "^29.1.1",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}